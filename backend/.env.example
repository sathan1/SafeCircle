# SafeCircle Backend Environment Configuration Template
# Copy to .env and configure for your environment. Never commit real keys.

PORT=5000
MONGODB_URI=mongodb://localhost:27017/safecircle
JWT_SECRET=your_super_secret_jwt_key_here

# Email OTP Service Provider: 'resend', 'sendgrid', or 'console' (for local testing/offline demo)
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=SafeCircle Security <security@safecircle.app>

# Security Parameters
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
